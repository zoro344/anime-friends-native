PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=*
# Set these on your own trusted server. Never put Watchium secrets in the Android APK.
WATCHIUM_SERVER_URL=
WATCHIUM_API_TOKEN=
# Optional comma-separated provider identities permitted to create rooms, e.g. anilist:12345
WATCHIUM_ALLOWED_IDENTITIES=
# Optional comma-separated or newline-separated HTTPS RSS feed URLs (multiple publishers).
ANIME_NEWS_RSS_URLS=
# Optional legacy single-feed setting; kept for backward compatibility.
ANIME_NEWS_RSS_URL=
